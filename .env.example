# Copia de referencia de las variables que necesita la app (sin valores reales).
# Local: .env.local se crea solo con "npm run db:iniciar".
# Vercel: se configuran en Settings → Environment Variables.

# Conexión a la base. En Vercel: la del "Transaction pooler" de Supabase (puerto 6543).
DATABASE_URL=postgresql://usuario:clave@servidor:puerto/base
# Clave para firmar las sesiones (mínimo 32 caracteres al azar). Genérala con:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
SESSION_SECRET=

# Solo en tu Mac, en el archivo .env.nube.local (para subir el esquema y los datos a Supabase):
# NUBE_DATABASE_URL=postgresql://...  (la de "Session pooler" de Supabase, puerto 5432)
